---
import BaseHead from "@/components/BaseHead.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import ArticleCard from "@/components/blog/ArticleCard.astro";
import Sidebar from "@/components/blog/Sidebar.astro";
import { SITE_TITLE } from "@/consts";
import { getTaxonomyDescription } from "@/data/taxonomyDescriptions";
import {
  getCategoryCounts,
  getPublishedWriting,
  getSeriesCounts,
  getTagCounts,
  getWritingStats,
  matchesTaxonomySlug,
  type TaxonomyCount,
  type WritingPost,
} from "@/lib/writing";

// Dynamic SSR — supports runtime-created posts with new categories
export const prerender = false;

const { category: catSlug } = Astro.params as { category: string };

const posts = await getPublishedWriting();
const categories = getCategoryCounts(posts);
const category = categories.find((c) => c.slug === catSlug);

if (!category) return Astro.redirect("/writing");

const filteredPosts = posts.filter((post: WritingPost) =>
  matchesTaxonomySlug(post.data.category, category.slug) ||
  matchesTaxonomySlug(post.data.categories, category.slug)
);
const stats = getWritingStats(posts);
const tags = getTagCounts(posts);
const series = getSeriesCounts(posts);
const description = getTaxonomyDescription("categories", category.slug);
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={`${category.name} | Writing | ${SITE_TITLE}`} description={`Writing filed under ${category.name}.`} />
  </head>
  <body>
    <Header />
    <main class="container mx-auto px-4 py-12 md:px-10 md:py-20">
      <section class="mx-auto mb-10 max-w-5xl rounded-3xl border-[3px] border-border-main bg-category-banner p-8 shadow-card">
        <p class="font-semibold text-pblack">Category</p>
        <h1 class="mt-2 text-5xl font-black md:text-7xl">{category.name}</h1>
        <p class="mt-4 text-lg text-text-main">
          {filteredPosts.length} article{filteredPosts.length === 1 ? "" : "s"} in this category.
          {description && <span class="mt-2 block text-base leading-7 text-pblack">{description}</span>}
        </p>
      </section>

      <div class="mx-auto grid max-w-6xl gap-8 sidebar-grid sidebar-grid--left">
        <Sidebar stats={stats} categories={categories} tags={tags} series={series} activeCategory={category.slug} />
        <section class="min-w-0 grid gap-8 md:grid-cols-2 md:gap-x-8 md:gap-y-10">
          {filteredPosts.map((post) => (
            <ArticleCard post={post} />
          ))}
        </section>
      </div>
    </main>
    <Footer />
  </body>
</html>
