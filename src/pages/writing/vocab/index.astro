---
import BaseHead from "@/components/BaseHead.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import PageBanner from "@/components/PageBanner.astro";
import FormattedDate from "@/components/FormattedDate.astro";
import {
  getPostUrl,
  getPublishedWriting,
  getVocabEntryCount,
  isVocabNote,
  type WritingPost,
} from "@/lib/writing";
import { SITE_TITLE } from "@/consts";

// Dynamic SSR — picks up runtime-created vocab notes without a rebuild.
export const prerender = false;

const posts = await getPublishedWriting();
const vocabPosts = posts.filter((post) => isVocabNote(post));

// Group by month; posts are already pubDate-descending, so months descend.
const byMonth = new Map<string, WritingPost[]>();
for (const p of vocabPosts) {
  const d = p.data.pubDate;
  const key = `${d.getFullYear()}年${d.getMonth() + 1}月`;
  const arr = byMonth.get(key) ?? [];
  arr.push(p);
  byMonth.set(key, arr);
}
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={`IELTS 词汇笔记 | Writing | ${SITE_TITLE}`} description="按日整理的雅思写作词汇学习记录，按月折叠查看。" />
  </head>
  <body>
    <Header />
    <main class="container mx-auto px-4 py-12 md:px-10 md:py-20">
      <PageBanner
        label="Writing · Vocab"
        title="IELTS 词汇笔记"
        description="按日整理的雅思写作词汇学习记录，按月折叠查看。"
      />

      <a
        href="/writing/"
        class="mx-auto mb-8 flex max-w-3xl items-center gap-1 rounded-full border border-border-main bg-card px-4 py-2 text-sm font-semibold text-text-main shadow-card1 transition hover:-translate-x-0.5 hover:-translate-y-0.5 hover:shadow-card"
      >
        ← 返回 Writing
      </a>

      {byMonth.size > 0 ? (
        <div class="mx-auto max-w-3xl space-y-4">
          {[...byMonth.entries()].map(([month, monthPosts], i) => (
            <details
              open={i === 0}
              class="rounded-3xl border-[3px] border-border-main bg-card p-5 shadow-card"
            >
              <summary class="cursor-pointer text-lg font-black text-pblack">
                {month}{" "}
                <span class="text-sm font-semibold text-pblack">
                  ({monthPosts.length} 篇)
                </span>
              </summary>
              <ul class="mt-3 divide-y divide-border-main">
                {monthPosts.map((post) => {
                  const entries = getVocabEntryCount(post);
                  return (
                    <li class="flex flex-wrap items-baseline gap-x-3 py-2.5">
                      <a
                        href={getPostUrl(post)}
                        class="font-semibold text-text-main hover:text-ppink"
                      >
                        {post.data.title}
                      </a>
                      <span class="text-sm text-pblack">
                        <FormattedDate date={post.data.pubDate} />
                      </span>
                      {entries > 0 && (
                        <span class="ml-auto text-xs text-pblack">
                          {entries} 词条
                        </span>
                      )}
                    </li>
                  );
                })}
              </ul>
            </details>
          ))}
        </div>
      ) : (
        <div class="mx-auto max-w-3xl rounded-3xl border-[3px] border-border-main bg-vocab-bg p-8 shadow-card">
          <h2 class="text-2xl font-bold">暂无词汇笔记</h2>
          <p class="mt-2 text-pblack">Vocabulary notes will appear here.</p>
        </div>
      )}
    </main>
    <Footer />
  </body>
</html>
