---
export const prerender = true;

import BaseHead from "@/components/BaseHead.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import PageBanner from "@/components/PageBanner.astro";
import { SITE_TITLE } from "@/consts";
import CapsulePlayer from "@/components/blog/CapsulePlayer.astro";

const areas = ["Computer Graphics", "Mathematical Modeling", "Operations Research", "AI", "Software Engineering", "Reading Notes"];
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={`Knowledge | ${SITE_TITLE}`} description="Future Quartz-powered knowledge base for seasKanon." />
  </head>
  <body>
    <Header />
    <main class="container mx-auto px-4 py-12 md:px-10 md:py-20">
      <PageBanner
        label="Knowledge"
        title="A future Quarto knowledge network."
        description="Knowledge will become an independent note system for linked concepts, reading notes, and long-term study. It stays separate from Writing, including search and taxonomy."
      />

      <section class="mx-auto mt-10 max-w-5xl rounded-3xl border-[3px] border-border-main bg-card p-6 shadow-card md:p-8">
        <div class="rounded-3xl border-[3px] border-border-main bg-pyellow p-6 shadow-card1">
          <h2 class="text-3xl font-black">Coming soon</h2>
          <p class="mt-3 leading-7 text-pblack">
            The current implementation only reserves this route and visual boundary. Quartz can later be mounted under `/knowledge` without coupling to Writing posts.
          </p>
        </div>
        <ul class="mt-6 grid gap-3 md:grid-cols-3">
          {areas.map((area) => (
            <li class="rounded-2xl border-2 border-border-main bg-pgreen px-4 py-3 font-bold shadow-card1">{area}</li>
          ))}
        </ul>

        <!-- ── Tools ── -->
        <div class="mt-10">
          <h2 class="text-2xl font-black mb-6 flex items-center gap-2">
            <span class="text-3xl">🔧</span> Tools
          </h2>
          <div class="flex flex-col gap-8">
            <a
              href="/tools/vocab-studio"
              class="group tool-card block rounded-3xl border-[3px] border-border-main p-6 shadow-card transition-all duration-200 hover:shadow-hover hover:-translate-x-2 hover:-translate-y-2"
            >
              <div class="flex items-start justify-between gap-4 flex-wrap">
                <div class="flex-1 min-w-0">
                  <h3 class="text-xl font-black">🔤 Vocab Studio</h3>
                  <p class="mt-2 leading-7 text-pblack">
                    词汇笔记工作室 — 从你的 Obsidian 词汇笔记中生成练习册，或借助 AI 丰富词汇内容。支持看英文写中文、连线匹配、选择题等多种题型。
                  </p>
                </div>
                <span class="tool-pill inline-flex items-center gap-2 rounded-2xl border-2 border-border-main bg-card px-4 py-2.5 font-bold shadow-card1 text-sm shrink-0 transition-colors duration-200">
                  进入工作室
                  <span class="text-lg leading-none transition-transform duration-200 group-hover:translate-x-1">→</span>
                </span>
              </div>
            </a>

            <a
              href="https://seaskanon.me/admin/files"
              class="group tool-card block rounded-3xl border-[3px] border-border-main p-6 shadow-card transition-all duration-200 hover:shadow-hover hover:-translate-x-2 hover:-translate-y-2"
            >
              <div class="flex items-start justify-between gap-4 flex-wrap">
                <div class="flex-1 min-w-0">
                  <h3 class="text-xl font-black">📂 Admin Files</h3>
                  <p class="mt-2 leading-7 text-pblack">
                    管理后台文件系统 — 直接访问 seaskanon.me 的文件管理面板，上传、整理和管理你的静态资源与文档。
                  </p>
                </div>
                <span class="tool-pill inline-flex items-center gap-2 rounded-2xl border-2 border-border-main bg-card px-4 py-2.5 font-bold shadow-card1 text-sm shrink-0 transition-colors duration-200">
                  打开面板
                  <span class="text-lg leading-none transition-transform duration-200 group-hover:translate-x-1">→</span>
                </span>
              </div>
            </a>
          </div>
        </div>
      </section>
    </main>
    <Footer />
    <CapsulePlayer />
  </body>

  <style>
    .tool-card {
      background-color: color-mix(in srgb, var(--accent-secondary) 15%, var(--bg-card));
    }
    .group:hover .tool-pill {
      background-color: color-mix(in srgb, var(--accent-secondary) 32%, var(--bg-card));
    }
  </style>
</html>
