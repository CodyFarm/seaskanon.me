---
// Vocab Studio · 词汇笔记工作室
// 管理员认证后才能使用的词汇笔记工具
import BaseHead from "@/components/BaseHead.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import CapsulePlayer from "@/components/blog/CapsulePlayer.astro";
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <BaseHead
      title="Vocab Studio · 词汇笔记工作室"
      description="词汇笔记练习册生成与内容丰富工具"
    />
    <style>
      /* ── Studio-specific styles ── */
      .studio-container {
        min-height: calc(100vh - 200px);
      }

      .studio-card {
        background: var(--bg-card);
        border: 3px solid var(--border-main);
        border-radius: 1.5rem;
        box-shadow: 4px 4px var(--shadow-color);
      }

      .studio-card--soft {
        background: var(--bg-card-soft);
        border: 2px solid var(--border-muted);
        border-radius: 1rem;
      }

      .studio-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.625rem 1.5rem;
        border: 2px solid var(--border-main);
        border-radius: 0.75rem;
        font-weight: 700;
        font-size: 0.875rem;
        cursor: pointer;
        transition: all 0.2s ease;
        box-shadow: 3px 3px var(--shadow-color);
        background: var(--bg-card);
        color: var(--text-main);
      }

      .studio-btn:hover {
        transform: translate(-2px, -2px);
        box-shadow: 6px 6px var(--shadow-color);
      }

      .studio-btn:active {
        transform: translate(0, 0);
        box-shadow: 1px 1px var(--shadow-color);
      }

      .studio-btn--primary {
        background: var(--accent-primary);
      }

      .studio-btn:disabled {
        opacity: 0.5;
        cursor: not-allowed;
        transform: none;
      }

      /* Simple text-only buttons (logout, refresh, etc.) */
      .studio-link {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        padding: 0.25rem 0.5rem;
        border: none;
        background: none;
        color: var(--text-muted);
        font-size: 0.8125rem;
        font-weight: 600;
        cursor: pointer;
        transition: color 0.15s ease;
        border-radius: 0.35rem;
      }

      .studio-link:hover {
        color: var(--accent-tertiary);
        background: color-mix(in srgb, var(--accent-tertiary) 8%, transparent);
      }

      /* Light action buttons (generate, save) */
      .studio-action {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.45rem 1rem;
        border: 1.5px solid var(--border-muted);
        border-radius: 0.6rem;
        background: var(--bg-card-soft);
        color: var(--text-main);
        font-size: 0.8125rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.15s ease;
      }

      .studio-action:hover {
        border-color: var(--accent-primary);
        color: var(--text-main);
      }

      .studio-action--primary {
        border-color: var(--accent-primary);
        background: color-mix(in srgb, var(--accent-primary) 20%, var(--bg-card));
      }

      .studio-action--primary:hover {
        background: color-mix(in srgb, var(--accent-primary) 35%, var(--bg-card));
      }

      .studio-action:disabled {
        opacity: 0.5;
        cursor: not-allowed;
      }

      .studio-input {
        width: 100%;
        padding: 0.625rem 1rem;
        border: 2px solid var(--border-main);
        border-radius: 0.75rem;
        background: var(--bg-card);
        color: var(--text-main);
        font-family: 'Alexandria', sans-serif;
        box-shadow: 2px 2px var(--shadow-color);
        transition: box-shadow 0.2s ease;
      }

      .studio-input:focus {
        outline: none;
        box-shadow: 4px 4px var(--accent-primary);
      }

      .studio-checkbox {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.5rem 0.75rem;
        border: 2px solid var(--border-muted);
        border-radius: 0.75rem;
        cursor: pointer;
        transition: all 0.15s ease;
        font-size: 0.875rem;
        background: var(--bg-card);
      }

      .studio-checkbox:hover {
        border-color: var(--accent-primary);
        background: var(--bg-card-soft);
      }

      .studio-checkbox.checked {
        border-color: var(--accent-primary);
        background: color-mix(in srgb, var(--accent-primary) 15%, var(--bg-card));
      }

      .studio-checkbox input {
        display: none;
      }

      .studio-checkbox .check-mark {
        width: 1.25rem;
        height: 1.25rem;
        border: 2px solid var(--border-main);
        border-radius: 0.35rem;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        font-size: 0.75rem;
        line-height: 1;
      }

      .studio-checkbox.checked .check-mark {
        background: var(--accent-primary);
      }

      .studio-checkbox.checked .check-mark::after {
        content: '✓';
        font-weight: 900;
        color: var(--text-main);
      }

      .studio-tab {
        padding: 0.5rem 1.25rem;
        border: 2px solid var(--border-main);
        border-radius: 0.75rem 0.75rem 0 0;
        font-weight: 700;
        font-size: 0.875rem;
        cursor: pointer;
        transition: all 0.15s ease;
        background: var(--bg-card-soft);
        color: var(--text-muted);
        border-bottom: none;
      }

      .studio-tab.active {
        background: var(--bg-card);
        color: var(--text-main);
        margin-bottom: -2px;
      }

      .studio-note-item {
        padding: 0.55rem 0.75rem;
        border: 2px solid var(--border-muted);
        border-left: 4px solid transparent;
        border-radius: 0.75rem;
        cursor: pointer;
        transition: all 0.15s ease;
        font-size: 0.8125rem;
        background: var(--bg-card);
      }

      .studio-note-item:hover {
        border-color: var(--accent-secondary);
      }

      .studio-note-item.active {
        border-color: var(--accent-secondary) !important;
        border-left: 5px solid var(--accent-secondary) !important;
        background: #e8f4fd !important;
        font-weight: 700;
        box-shadow: 2px 2px 0 color-mix(in srgb, var(--accent-secondary) 40%, transparent);
      }

      .studio-preview {
        max-height: 50vh;
        overflow-y: auto;
        padding: 1rem;
        border: 2px solid var(--border-muted);
        border-radius: 1rem;
        background: var(--bg-card-soft);
        font-size: 0.8125rem;
        line-height: 1.7;
        white-space: pre-wrap;
        font-family: 'Alexandria', monospace;
      }

      .studio-overlay {
        position: fixed;
        inset: 0;
        z-index: 100;
        display: flex;
        align-items: center;
        justify-content: center;
        background: var(--bg-body);
      }

      .studio-overlay.hidden {
        display: none;
      }

      .studio-badge {
        display: inline-block;
        padding: 0.15rem 0.5rem;
        border-radius: 0.35rem;
        font-size: 0.7rem;
        font-weight: 700;
        background: var(--accent-secondary);
        color: var(--text-main);
      }

      .studio-toast {
        position: fixed;
        bottom: 2rem;
        right: 2rem;
        max-width: 28rem;
        padding: 0.75rem 1rem;
        border: 3px solid var(--border-main);
        border-radius: 1rem;
        background: var(--bg-card);
        box-shadow: 4px 4px var(--shadow-color);
        font-weight: 700;
        font-size: 0.875rem;
        z-index: 200;
        animation: slideUp 0.3s ease;
        display: flex;
        align-items: flex-start;
        gap: 0.75rem;
      }

      .studio-toast.success {
        border-color: var(--accent-primary);
      }

      .studio-toast.error {
        border-color: var(--accent-spot);
      }

      .studio-toast .toast-close {
        flex-shrink: 0;
        background: none;
        border: none;
        cursor: pointer;
        font-size: 1rem;
        line-height: 1;
        color: var(--text-muted);
        padding: 0;
      }

      .studio-toast .toast-close:hover {
        color: var(--text-main);
      }

      @keyframes slideUp {
        from { transform: translateY(100px); opacity: 0; }
        to { transform: translateY(0); opacity: 1; }
      }

      @keyframes spin {
        to { transform: rotate(360deg); }
      }

      .studio-spinner {
        width: 1.25rem;
        height: 1.25rem;
        border: 3px solid var(--border-muted);
        border-top-color: var(--accent-primary);
        border-radius: 50%;
        animation: spin 0.6s linear infinite;
        display: inline-block;
      }

      .mastery-dots {
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
      }

      .mastery-dot {
        width: 0.65rem;
        height: 0.65rem;
        border: 1.5px solid var(--border-muted);
        border-radius: 50%;
        background: color-mix(in srgb, var(--text-muted) 25%, var(--bg-card));
      }

      .mastery-dot.active {
        border-color: color-mix(in srgb, #2f9e44 75%, var(--border-main));
        background: #51cf66;
      }

      .writing-loading {
        min-height: 15rem;
        align-items: center;
        justify-content: center;
        text-align: center;
      }

      .writing-loading .studio-spinner {
        width: 2.5rem;
        height: 2.5rem;
        border-width: 4px;
      }
    </style>
  </head>
  <body>
    <Header />
    <main class="container mx-auto px-4 md:px-10 pt-12 pb-20">
      <!-- ════════════════ Login Overlay ════════════════ -->
      <div id="login-overlay" class="studio-overlay">
        <div class="studio-card p-8 w-full max-w-md mx-4">
          <h1 class="text-3xl font-black text-text-main mb-4">
            🔤 Vocab Studio
          </h1>
          <p class="text-text-muted mb-8">词汇笔记工作室 · 管理员登录</p>
          <form id="login-form" class="flex flex-col gap-6">
            <input
              id="login-password"
              type="password"
              class="studio-input"
              placeholder="请输入管理员密码"
              autocomplete="current-password"
            />
            <p id="login-error" class="text-sm text-[--accent-spot] hidden"></p>
            <button type="submit" class="studio-action studio-action--primary justify-center text-base py-3">
              🔑 进入工作室
            </button>
          </form>
        </div>
      </div>

      <!-- ════════════════ Main Workspace (hidden until authenticated) ════════════════ -->
      <div id="workspace" class="hidden">
        <div class="flex items-center justify-between mb-10">
          <div>
            <h1 class="text-4xl font-black text-text-main">
              🔤 Vocab Studio
            </h1>
            <p class="text-text-muted mt-2">词汇笔记工作室 — 生成练习册 & 丰富笔记内容</p>
          </div>
          <button id="logout-btn" class="studio-link">
            🚪 退出
          </button>
        </div>

        <div class="grid gap-8 sidebar-grid sidebar-grid--left">
          <!-- ═════════ Left: Note List ═════════ -->
          <aside class="flex flex-col gap-5">
            <div class="studio-card p-5">
              <div class="flex items-center justify-between mb-3">
                <h2 class="text-lg font-black text-text-main">📋 笔记列表</h2>
                <button id="refresh-notes-btn" class="studio-link" title="刷新列表">
                  🔄 刷新
                </button>
              </div>
              <input
                id="notes-search"
                type="text"
                class="studio-input text-sm mb-3"
                placeholder="🔍 搜索笔记..."
              />
              <div id="notes-list" class="flex flex-col gap-2.5 max-h-[55vh] overflow-y-auto">
                <p class="text-sm text-text-muted">加载中...</p>
              </div>
              <div id="notes-count" class="mt-3 text-xs text-text-muted"></div>
            </div>
          </aside>

          <!-- ═════════ Right: Workspace ═════════ -->
          <div class="flex flex-col gap-5">
            <!-- Tabs -->
            <div class="flex border-b-2 border-border-main">
              <button class="studio-tab active" data-tab="exercise">
                🎯 生成练习册
              </button>
              <button class="studio-tab" data-tab="enrich">
                ✨ 丰富笔记
              </button>
              <button class="studio-tab" data-tab="library">
                📚 词汇库
              </button>
              <button class="studio-tab" data-tab="writing">
                ✍️ 短写作
              </button>
            </div>

            <!-- ─── Tab 1: Exercise Builder ─── -->
            <div id="tab-exercise" class="studio-card p-6 flex flex-col gap-5">
              <!-- Source toggle: from-note vs from-pasted-text -->
              <div class="flex gap-2">
                <button id="src-note-btn" class="studio-action studio-action--primary">
                  📋 从笔记
                </button>
                <button id="src-paste-btn" class="studio-action">
                  📝 从粘贴文本
                </button>
              </div>

              <p id="exercise-no-note" class="text-text-muted text-sm">
                👈 请先从左侧选择一篇词汇笔记
              </p>

              <!-- Paste-text source panel -->
              <div id="exercise-paste-panel" class="hidden flex-col gap-3">
                <textarea
                  id="paste-textarea"
                  class="studio-input h-40 resize-y"
                  placeholder="粘贴任意英文文本，AI 将统计英文单词数量并测试模型连接...&#10;例如：一篇文章、一个词表、或任意包含英语短语的内容"
                ></textarea>
                <button id="paste-analyze-btn" class="studio-action studio-action--primary self-start">
                  🔍 分析词汇
                </button>
                <button id="paste-import-btn" type="button" class="studio-action hidden">➕ 审核后加入词汇库</button>
                <div id="paste-result" class="hidden flex-col gap-2">
                  <div class="flex items-center gap-2 flex-wrap">
                    <span id="paste-count" class="studio-badge"></span>
                    <span id="paste-conn" class="text-xs font-semibold"></span>
                  </div>
                </div>
              </div>

              <div id="exercise-content" class="hidden flex flex-col gap-6">
                <!-- Question types -->
                <div>
                  <h3 class="text-sm font-black text-text-main mb-4">1. 选择题型（可多选）</h3>
                  <div class="grid grid-cols-2 md:grid-cols-3 gap-3" id="exercise-types">
                    <label class="studio-checkbox" data-type="en_to_cn">
                      <span class="check-mark"></span>
                      🇬🇧→🇨🇳 看英文写中文
                    </label>
                    <label class="studio-checkbox" data-type="cn_to_en">
                      <span class="check-mark"></span>
                      🇨🇳→🇬🇧 看中文写英文
                    </label>
                    <label class="studio-checkbox" data-type="fill_blank">
                      <span class="check-mark"></span>
                      ✍️ 短语填入例句
                    </label>
                    <label class="studio-checkbox" data-type="matching">
                      <span class="check-mark"></span>
                      🔗 连线匹配
                    </label>
                    <label class="studio-checkbox" data-type="multiple_choice">
                      <span class="check-mark"></span>
                      📝 选择释义
                    </label>
                  </div>
                </div>

                <!-- Custom format -->
                <div>
                  <h3 class="text-sm font-black text-text-main mb-3">
                    2. 自定义题型 <span class="text-text-muted font-normal">（可选）</span>
                  </h3>
                  <textarea
                    id="exercise-custom"
                    class="studio-input h-20 resize-y"
                    placeholder="描述你想要的自定义题型，例如：&#10;请设计5道根据语境选择题，每道题给一个英文句子，让学生选择正确的短语填入。&#10;或者：请按雅思写作 Task 2 的题型，给每个短语出一个完整造句题。"
                  ></textarea>
                </div>

                <!-- Generate -->
                <button id="exercise-generate-btn" class="studio-action studio-action--primary py-2.5 text-base mt-3">
                  🪄 生成练习册
                </button>
                <p id="exercise-status" class="text-sm text-text-muted hidden"></p>
              </div>
            </div>

            <!-- ─── Tab 2: Enrich Builder ─── -->
            <div id="tab-enrich" class="studio-card p-6 flex-col gap-5 hidden">
              <p id="enrich-no-note" class="text-text-muted text-sm">
                👈 请先从左侧选择一篇词汇笔记
              </p>

              <div id="enrich-content" class="hidden flex flex-col gap-6">
                <!-- Enrichment options -->
                <div>
                  <h3 class="text-sm font-black text-text-main mb-4">选择要丰富的内容</h3>
                  <div class="grid grid-cols-2 md:grid-cols-3 gap-3" id="enrich-options">
                    <label class="studio-checkbox" data-option="examples">
                      <span class="check-mark"></span>
                      📝 增加例句
                    </label>
                    <label class="studio-checkbox" data-option="synonymsEn">
                      <span class="check-mark"></span>
                      🔤 英文同义表达
                    </label>
                    <label class="studio-checkbox" data-option="synonymsCn">
                      <span class="check-mark"></span>
                      🀄 中文同义表达
                    </label>
                    <label class="studio-checkbox" data-option="roots">
                      <span class="check-mark"></span>
                      🌱 词根词缀解释
                    </label>
                    <label class="studio-checkbox" data-option="categories">
                      <span class="check-mark"></span>
                      📂 分类记忆整理
                    </label>
                  </div>
                </div>

                <!-- Generate -->
                <button id="enrich-generate-btn" class="studio-action studio-action--primary py-2.5 text-base mt-3">
                  🪄 生成丰富内容
                </button>
                <button id="enrich-import-btn" type="button" class="studio-action">➕ 从笔记提取并审核</button>
                <p id="enrich-status" class="text-sm text-text-muted hidden"></p>
              </div>
            </div>

            <div id="tab-library" class="studio-card p-6 flex-col gap-5 hidden">
              <div class="flex items-center justify-between gap-3 flex-wrap">
                <div><h2 class="text-lg font-black text-text-main">📚 词汇库</h2><p id="library-stats" class="text-xs text-text-muted mt-1"></p></div>
                <div class="flex items-center gap-2 flex-wrap justify-end">
                  <button id="llm-test-btn" type="button" class="studio-action text-xs">测试模型连接</button>
                  <button id="library-add-btn" type="button" class="studio-action studio-action--primary" aria-expanded="false">＋ 添加单词</button>
                </div>
              </div>
              <p id="llm-test-status" class="text-xs text-text-muted hidden" aria-live="polite"></p>
              <div id="library-add-menu" class="studio-card--soft p-4 hidden flex-col gap-3">
                <div>
                  <h3 class="text-sm font-black text-text-main">选择添加方式</h3>
                  <p id="library-add-note-context" class="text-xs text-text-muted mt-1">尚未选择左侧笔记</p>
                </div>
                <div class="flex gap-2 flex-wrap">
                  <button id="library-add-manual-btn" type="button" class="studio-action">手动填写</button>
                  <button id="library-add-note-btn" type="button" class="studio-action studio-action--primary" disabled>从已选笔记提取</button>
                </div>
              </div>
              <div class="flex gap-3 flex-wrap"><input id="library-search" class="studio-input text-sm" placeholder="搜索单词或释义..." /><select id="library-mastery" class="studio-input text-sm"><option value="">全部等级</option><option value="1">1 初识</option><option value="2">2 认得</option><option value="3">3 能用</option><option value="4">4 熟练</option><option value="5">5 稳定</option></select></div>
              <form id="library-form" class="studio-card--soft p-4 hidden flex-col gap-3">
                <div class="flex gap-2 items-stretch flex-wrap sm:flex-nowrap">
                  <input id="library-word" class="studio-input" placeholder="单词或短语" required />
                  <button id="library-ai-btn" type="button" class="studio-action studio-action--primary shrink-0">✨ AI 补充属性</button>
                </div>
                <input id="library-pos" class="studio-input" placeholder="词性" required />
                <input id="library-zh" class="studio-input" placeholder="中文释义" required />
                <input id="library-en" class="studio-input" placeholder="英文释义" required />
                <select id="library-level" class="studio-input"><option value="1">1 初识</option><option value="2">2 认得</option><option value="3">3 能用</option><option value="4">4 熟练</option><option value="5">5 稳定</option></select>
                <p id="library-ai-status" class="text-sm text-text-muted hidden" aria-live="polite"></p>
                <div class="flex gap-2"><button type="submit" class="studio-action studio-action--primary">保存</button><button id="library-cancel-btn" type="button" class="studio-action">取消</button></div>
                <p id="library-form-error" class="text-sm text-[--accent-spot] hidden"></p>
              </form>
              <div id="library-list" class="flex flex-col gap-2"><p class="text-sm text-text-muted">加载中...</p></div>
            </div>

            <div id="tab-writing" class="studio-card p-6 flex-col gap-5 hidden">
              <h2 class="text-lg font-black text-text-main">✍️ 短写作练习</h2>
              <div id="writing-config" class="flex flex-col gap-3"><input id="writing-topic" class="studio-input" placeholder="主题（可选，例如：education）" /><div class="flex gap-2 flex-wrap"><select id="writing-type" class="studio-input"><option value="opinion">观点段</option><option value="reason">原因段</option><option value="example">例证段</option><option value="concession">让步段</option></select><select id="writing-mix" class="studio-input"><option value="balanced">均衡词汇</option><option value="review">巩固优先</option><option value="new">新词优先</option></select></div><button id="writing-start" type="button" class="studio-action studio-action--primary">生成短写作任务</button></div>
              <div id="writing-loading" class="writing-loading hidden flex-col gap-4" aria-live="polite"><span class="studio-spinner" aria-hidden="true"></span><div><p id="writing-loading-title" class="font-black text-text-main">正在生成写作任务</p><p id="writing-loading-detail" class="text-sm text-text-muted mt-1">AI 正在结合本次词汇准备练习内容...</p></div></div>
              <div id="writing-task" class="hidden flex flex-col gap-3"><p id="writing-instruction" class="font-semibold"></p><ul id="writing-hints" class="text-sm text-text-muted"></ul><div id="writing-words" class="flex gap-2 flex-wrap"></div><textarea id="writing-text" class="studio-input h-56 resize-y" placeholder="写 80–140 词的一个段落..."></textarea><div class="flex items-center justify-between"><span id="writing-count" class="text-sm text-text-muted">0 词</span><button id="writing-submit" type="button" class="studio-action studio-action--primary">提交批改</button></div></div>
              <div id="writing-result" class="hidden flex flex-col gap-3"><h3 class="font-black">批改结果</h3><p id="writing-comment"></p><div id="writing-feedback" class="text-sm"></div><button id="writing-again" type="button" class="studio-action">再写一遍</button></div>
            </div>

            <div id="selection-confirm" class="studio-card p-6 flex-col gap-4 hidden">
              <div><h2 class="text-lg font-black text-text-main">✅ 确认本次使用的词汇</h2><p class="text-sm text-text-muted">生成内容前请检查词形、释义和掌握等级。这里的修改只影响本次生成，不会改动词汇库。</p></div>
              <div id="selection-confirm-list" class="flex flex-col gap-2"></div>
              <div class="flex gap-3"><button id="selection-confirm-btn" type="button" class="studio-action studio-action--primary">确认并生成</button><button id="selection-cancel-btn" type="button" class="studio-action">返回修改</button></div>
            </div>

            <div id="candidate-review" class="studio-card p-6 flex-col gap-4 hidden">
              <div><h2 class="text-lg font-black text-text-main">🔎 审核候选词</h2><p id="candidate-source" class="text-xs text-text-muted mt-1"></p><p class="text-sm text-text-muted mt-1">可取消勾选或修改属性；只有确认后才会写入词汇库。已存在词仅更新词性与释义，掌握等级请在词汇库中编辑。</p></div>
              <div id="candidate-list" class="flex flex-col gap-2"></div>
              <div class="flex gap-3"><button id="candidate-import-btn" type="button" class="studio-action studio-action--primary">确认加入</button><button id="candidate-cancel-btn" type="button" class="studio-action">取消</button></div>
            </div>

              <!-- ─── Preview Panel (shared) ─── -->
              <div id="preview-panel" class="studio-card p-6 flex-col gap-5 hidden">
              <div class="flex items-center justify-between">
                <h2 class="text-lg font-black text-text-main">
                  👁️ 预览结果
                  <span id="preview-mode-badge" class="studio-badge ml-2"></span>
                </h2>
              </div>
              <div class="flex flex-col gap-1.5">
                <label for="preview-filename" class="text-xs font-semibold text-text-muted">
                  文件名（.md 会自动添加，可直接编辑）
                </label>
                <input
                  id="preview-filename"
                  class="studio-input text-sm"
                  placeholder="例如：雅思写作常用写作词汇--教育类-练习册"
                />
              </div>
              <textarea
                id="preview-content"
                class="studio-preview w-full resize-y"
                rows="16"
                placeholder="生成的内容，可直接编辑..."
              ></textarea>
              <div class="flex gap-3 flex-wrap">
                <button id="save-btn" class="studio-action studio-action--primary">
                  💾 <span id="save-btn-label">保存</span>
                </button>
                <button id="copy-btn" class="studio-action">
                  📋 复制内容
                </button>
                <button id="clear-preview-btn" class="studio-link">
                  ✕ 清除预览
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Toast container -->
      <div id="toast-container"></div>
    </main>
    <Footer />
    <CapsulePlayer />

    <!-- ════════════════ Client Script ════════════════ -->
    <script is:inline>
    (function () {
      if (window.__vocabStudioReady) return;
      window.__vocabStudioReady = true;

      // ── State ──
      let selectedNote = null;
      let currentMode = 'exercise'; // 'exercise' | 'enrich'
      let generatedTitle = null;
      let exerciseSource = 'note'; // 'note' | 'paste' (exercise tab only)
      let pasteWordCount = 0;
      let pasteAnalyzed = false; // true after a successful (connected) analyze
      let libraryEntries = [], libraryRevision = '', libraryEditing = null;
      let selectionConfirmed = false;
      let writingTask = null;
      let pendingSelectionAction = 'exercise';
      let confirmedEntries = [];
      let candidateBatch = null;

      // ── DOM refs ──
      function $(id) { return document.getElementById(id); }
      function $$(sel) { return document.querySelectorAll(sel); }
      function escapeHtml(value) { return String(value ?? '').replace(/[&<>"']/g, char => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[char])); }
      async function readJsonResponse(response) {
        const contentType = response.headers.get('content-type') || '';
        if (!contentType.includes('application/json')) {
          throw new Error(`服务器返回了非 JSON 响应（HTTP ${response.status}）`);
        }
        return response.json();
      }

      const loginOverlay = $('login-overlay');
      const loginForm = $('login-form');
      const loginPassword = $('login-password');
      const loginError = $('login-error');
      const workspace = $('workspace');

      // ── Auth ──
      async function checkAuth() {
        try {
          const res = await fetch('/api/vocab/list-notes');
          if (res.ok) return true;
        } catch (e) {}
        return false;
      }

      async function tryLogin(password) {
        try {
          const res = await fetch('/api/vocab/auth', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ password }),
          });
          return res.ok;
        } catch (e) {
          return false;
        }
      }

      loginForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        const pw = loginPassword.value.trim();
        if (!pw) return;

        loginError.classList.add('hidden');
        const ok = await tryLogin(pw);
        if (ok) {
          loginOverlay.classList.add('hidden');
          workspace.classList.remove('hidden');
          loadNotes();
          loadLibrary();
        } else {
          loginError.textContent = '❌ 密码错误，请重试';
          loginError.classList.remove('hidden');
          loginPassword.value = '';
          loginPassword.focus();
        }
      });

      $('logout-btn').addEventListener('click', () => {
        // Clear session cookie
        document.cookie = 'vocab_session=; Path=/; Max-Age=0';
        workspace.classList.add('hidden');
        loginOverlay.classList.remove('hidden');
        loginPassword.value = '';
        selectedNote = null;
        $('preview-content').value = '';
        $('preview-filename').value = '';
        $('preview-panel').classList.add('hidden');
        $('preview-panel').classList.remove('flex');
        updateUI();
      });

      // ── Notes ──
      let allNotes = []; // full list from API

      async function loadNotes() {
        const listEl = $('notes-list');
        const countEl = $('notes-count');
        listEl.innerHTML = '<p class="text-sm text-text-muted">加载中...</p>';

        try {
          const res = await fetch('/api/vocab/list-notes');
          if (!res.ok) {
            workspace.classList.add('hidden');
            loginOverlay.classList.remove('hidden');
            return;
          }
          allNotes = await res.json();
          if (allNotes.length === 0) {
            listEl.innerHTML = '<p class="text-sm text-text-muted">未找到任何笔记文件</p>';
            countEl.textContent = '';
            return;
          }
          renderNotesList(allNotes);
        } catch (e) {
          listEl.innerHTML = '<p class="text-sm" style="color: var(--accent-spot)">加载失败</p>';
        }
      }

      function renderNotesList(notes, keepSelection) {
        const listEl = $('notes-list');
        const countEl = $('notes-count');
        const currentSlug = selectedNote ? selectedNote.slug : null;

        if (notes.length === 0) {
          listEl.innerHTML = '<p class="text-sm text-text-muted">无匹配结果</p>';
          countEl.textContent = '';
          return;
        }

        listEl.innerHTML = notes.map((n) => {
          const selClass = (keepSelection && n.slug === currentSlug) ? ' active' : '';
          const badge = n.isVocabNote
            ? '<span class="studio-badge">词汇</span>'
            : '<span class="text-xs text-text-muted">·</span>';
          return `
            <div class="studio-note-item${selClass}" data-slug="${n.slug}">
              <div class="flex items-center justify-between gap-2">
                <span class="font-semibold text-text-main truncate">${n.title}</span>
                ${badge}
              </div>
              <div class="text-text-muted text-xs mt-0.5">
                ${n.entryCount} 条 · ${n.englishWordCount} 英文词
              </div>
            </div>
          `;
        }).join('');

        // Click handlers
        listEl.querySelectorAll('.studio-note-item').forEach((el) => {
          el.addEventListener('click', () => {
            listEl.querySelectorAll('.studio-note-item').forEach((e) => {
              e.classList.remove('active');
              e.style.borderLeftColor = '';
              e.style.background = '';
              e.style.fontWeight = '';
            });
            el.classList.add('active');
            el.style.borderLeftColor = 'var(--accent-secondary)';
            el.style.background = '#e8f4fd';
            el.style.fontWeight = '700';
            selectedNote = {
              slug: el.dataset.slug,
              title: el.querySelector('.font-semibold').textContent,
            };
            updateUI();
          });
        });

        // Restore inline styles for kept selection
        if (keepSelection && currentSlug) {
          const activeEl = listEl.querySelector('.studio-note-item.active');
          if (activeEl) {
            activeEl.style.borderLeftColor = 'var(--accent-secondary)';
            activeEl.style.background = '#e8f4fd';
            activeEl.style.fontWeight = '700';
          }
        }

        countEl.textContent = `共 ${allNotes.length} 篇（显示 ${notes.length} 篇）`;
      }

      // Search
      const searchInput = $('notes-search');
      if (searchInput) {
        searchInput.addEventListener('input', (e) => {
        const q = e.target.value.trim().toLowerCase();
        if (!q) {
          // Default: show vocab notes first (≥15 English words)
          renderNotesList(
            allNotes.filter((n) => n.englishWordCount >= 15 || n.isVocabNote),
            true
          );
        } else {
          renderNotesList(
            allNotes.filter((n) =>
              n.title.toLowerCase().includes(q) ||
              n.slug.toLowerCase().includes(q)
            ),
            true
          );
        }
      });
      } // end if (searchInput)

      $('refresh-notes-btn').addEventListener('click', loadNotes);

      // ── Tabs ──
      $$('.studio-tab').forEach((tab) => {
        tab.addEventListener('click', () => {
          $$('.studio-tab').forEach((t) => t.classList.remove('active'));
          tab.classList.add('active');
          currentMode = tab.dataset.tab;

          $('tab-exercise').classList.toggle('hidden', currentMode !== 'exercise');
          $('tab-exercise').classList.toggle('flex', currentMode === 'exercise');
          $('tab-enrich').classList.toggle('hidden', currentMode !== 'enrich');
          $('tab-enrich').classList.toggle('flex', currentMode === 'enrich');
          $('tab-library').classList.toggle('hidden', currentMode !== 'library');
          $('tab-library').classList.toggle('flex', currentMode === 'library');
          $('tab-writing').classList.toggle('hidden', currentMode !== 'writing');
          $('tab-writing').classList.toggle('flex', currentMode === 'writing');

          if (currentMode === 'library') loadLibrary();

          updateUI();
        });
      });

      async function loadLibrary() { const listEl = $('library-list'); try { const res = await fetch('/api/vocab/library'); const data = await res.json().catch(() => null); if (!res.ok) { if (res.status === 401) throw new Error('登录已过期，请重新登录'); throw new Error(`${data?.error?.message || '加载失败'}（HTTP ${res.status}）`); } libraryEntries = data?.entries || []; libraryRevision = data?.revision || ''; renderLibrary(); } catch (error) { const message = error instanceof Error ? error.message : '加载失败'; listEl.innerHTML = `<p class="text-sm text-[--accent-spot]">${escapeHtml(message)}</p><button type="button" id="library-retry" class="studio-action self-start">重试</button>`; } }
      function masteryDots(level) { const active=Math.max(0,Math.min(4,Number(level)-1)); return `<span class="mastery-dots" role="img" aria-label="掌握等级 ${level}，5 档"><span class="mastery-dot ${active>0?'active':''}"></span><span class="mastery-dot ${active>1?'active':''}"></span><span class="mastery-dot ${active>2?'active':''}"></span><span class="mastery-dot ${active>3?'active':''}"></span></span>`; }
      function renderLibrary() { const q = ($('library-search').value || '').toLowerCase(); const level = $('library-mastery').value; const list = libraryEntries.filter(e => (!q || [e.word,e.meaningZh,e.meaningEn].some(v => v.toLowerCase().includes(q))) && (!level || String(e.mastery) === level)); $('library-stats').textContent = `共 ${libraryEntries.length} 词 · 当前显示 ${list.length} 词`; $('library-list').innerHTML = list.length ? list.map(e => `<div class="studio-note-item flex items-start justify-between gap-3"><div class="min-w-0 flex-1"><div class="flex items-center gap-3 flex-wrap"><strong class="text-base">${escapeHtml(e.word)}</strong>${masteryDots(e.mastery)}</div><div class="text-xs text-text-muted mt-1">${escapeHtml(e.partOfSpeech)} · ${escapeHtml(e.meaningZh)}</div><div class="text-sm text-text-main mt-1 leading-relaxed">${escapeHtml(e.meaningEn)}</div></div><div class="flex gap-2 shrink-0"><button type="button" class="studio-action" data-edit-word="${escapeHtml(e.word)}">编辑</button><button type="button" class="studio-action" data-delete-word="${escapeHtml(e.word)}">删除</button></div></div>`).join('') : '<p class="text-sm text-text-muted">暂无词汇</p>'; }
      function resetLibraryFormStatus() { $('library-form-error').classList.add('hidden'); $('library-ai-status').classList.add('hidden'); $('library-ai-status').textContent=''; }
      function openManualLibraryForm() { libraryEditing = null; $('library-add-menu').classList.add('hidden'); $('library-add-menu').classList.remove('flex'); $('library-add-btn').setAttribute('aria-expanded', 'false'); $('library-form').classList.remove('hidden'); $('library-form').classList.add('flex'); resetLibraryFormStatus(); ['word','pos','zh','en'].forEach(k => $('library-' + k).value = ''); $('library-level').value = '1'; $('library-word').focus(); }
      $('library-search').addEventListener('input', renderLibrary); $('library-mastery').addEventListener('change', renderLibrary); $('library-add-btn').addEventListener('click', () => { const menu=$('library-add-menu'); const willOpen=menu.classList.contains('hidden'); menu.classList.toggle('hidden', !willOpen); menu.classList.toggle('flex', willOpen); $('library-add-btn').setAttribute('aria-expanded', String(willOpen)); }); $('library-add-manual-btn').addEventListener('click', openManualLibraryForm); $('library-cancel-btn').addEventListener('click', () => $('library-form').classList.add('hidden'));
      $('llm-test-btn').addEventListener('click', async () => {
        const button = $('llm-test-btn');
        const status = $('llm-test-status');
        button.disabled = true;
        button.textContent = '正在测试...';
        status.textContent = '正在发送最小请求，不会消耗明显额度...';
        status.classList.remove('hidden');
        try {
          const response = await fetch('/api/vocab/llm/test', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({}),
          });
          const data = await readJsonResponse(response);
          if (response.status === 401) {
            workspace.classList.add('hidden');
            loginOverlay.classList.remove('hidden');
            loginError.textContent = '登录已失效，请重新登录后测试模型连接。';
            loginError.classList.remove('hidden');
            throw new Error('管理员登录已失效');
          }
          if (!response.ok || !data.connected) throw new Error(data.error || `连接失败（HTTP ${response.status}）`);
          status.textContent = `连接正常 · ${data.model} · ${data.endpoint} · ${data.elapsedMs} ms`;
        } catch (error) {
          status.textContent = error instanceof TypeError
            ? '无法连接到本站测试接口，请确认开发服务器已重启或 Railway 已重新部署。'
            : `连接失败：${error instanceof Error ? error.message : '未知错误'}`;
        } finally {
          button.disabled = false;
          button.textContent = '测试模型连接';
        }
      });
      $('library-list').addEventListener('click', async (event) => { if (event.target.closest('#library-retry')) { await loadLibrary(); return; } const edit = event.target.closest('[data-edit-word]'); const del = event.target.closest('[data-delete-word]'); if (edit) { const e = libraryEntries.find(x => x.word === edit.dataset.editWord); if (!e) return; libraryEditing = e.word; resetLibraryFormStatus(); $('library-form').classList.remove('hidden'); $('library-form').classList.add('flex'); $('library-word').value=e.word; $('library-pos').value=e.partOfSpeech; $('library-zh').value=e.meaningZh; $('library-en').value=e.meaningEn; $('library-level').value=e.mastery; $('library-form').scrollIntoView({behavior:'smooth',block:'nearest'}); } if (del && confirm(`确定删除 ${del.dataset.deleteWord}？`)) { const res = await fetch('/api/vocab/library',{method:'DELETE',headers:{'Content-Type':'application/json'},body:JSON.stringify({word:del.dataset.deleteWord,expectedRevision:libraryRevision})}); if (!res.ok) { alert('删除失败，请刷新后重试'); } await loadLibrary(); } });
      $('library-ai-btn').addEventListener('click', async () => { const word=$('library-word').value.trim(); const status=$('library-ai-status'); const button=$('library-ai-btn'); resetLibraryFormStatus(); if(!word){status.textContent='请先输入单词或短语';status.classList.remove('hidden');$('library-word').focus();return;} button.disabled=true; button.innerHTML='<span class="studio-spinner"></span> AI 生成中'; status.textContent='正在分析词性并整理双语释义...'; status.classList.remove('hidden'); try { const res=await fetch('/api/vocab/library/enrich',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({word,current:{partOfSpeech:$('library-pos').value,meaningZh:$('library-zh').value,meaningEn:$('library-en').value}})}); const data=await readJsonResponse(res); if(!res.ok)throw new Error(data.error||'AI 补充失败'); $('library-pos').value=data.attributes.partOfSpeech; $('library-zh').value=data.attributes.meaningZh; $('library-en').value=data.attributes.meaningEn; status.textContent='AI 已填入建议，你可以继续修改后再保存。'; } catch(error) { status.textContent=error instanceof TypeError?'无法连接到本站接口，请重启开发服务器或重新部署 Railway。':error instanceof Error?error.message:'AI 补充失败，请稍后重试'; } finally { button.disabled=false; button.textContent='✨ AI 补充属性'; } });
      $('library-form').addEventListener('submit', async (event) => { event.preventDefault(); const entry={word:$('library-word').value,partOfSpeech:$('library-pos').value,meaningZh:$('library-zh').value,meaningEn:$('library-en').value,mastery:Number($('library-level').value)}; const body=libraryEditing?{originalWord:libraryEditing,patch:entry,expectedRevision:libraryRevision}:{entry,expectedRevision:libraryRevision}; const res=await fetch('/api/vocab/library',{method:libraryEditing?'PATCH':'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)}); if(!res.ok){$('library-form-error').textContent='保存失败，请检查字段或刷新后重试';$('library-form-error').classList.remove('hidden');return;} $('library-form').classList.add('hidden'); await loadLibrary(); });
      function setWritingLoading(active,title,detail) { const loading=$('writing-loading'); if(active){ $('writing-config').classList.add('hidden'); $('writing-task').classList.add('hidden'); $('writing-result').classList.add('hidden'); $('writing-loading-title').textContent=title; $('writing-loading-detail').textContent=detail; loading.classList.remove('hidden'); loading.classList.add('flex'); } else { loading.classList.add('hidden'); loading.classList.remove('flex'); } }
      $('writing-start').addEventListener('click', async () => { pendingSelectionAction = 'writing'; openSelectionConfirm(); });
      $('writing-text').addEventListener('input', () => { $('writing-count').textContent = `${($('writing-text').value.match(/[A-Za-z]+(?:['-][A-Za-z]+)*/g)||[]).length} 词`; });
      $('writing-submit').addEventListener('click', async () => { const text=$('writing-text').value.trim(); if(!text){alert('请先写一段文字');return;} setWritingLoading(true,'正在分析你的段落','AI 正在检查结构、表达和目标词汇的使用...'); try { const res=await fetch('/api/vocab/writing/grade',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({task:writingTask,text})}); const data=await readJsonResponse(res); if(!res.ok)throw new Error(data.error||'批改失败'); $('writing-comment').textContent=data.feedback.overallComment; $('writing-feedback').innerHTML=data.feedback.targetWordUsage.map(u=>`<p><strong>${escapeHtml(u.word)}</strong>：${u.status === 'not_used' ? '未使用' : '已出现'} ${escapeHtml(u.comment)}</p>`).join(''); setWritingLoading(false); $('writing-result').classList.remove('hidden'); $('writing-result').classList.add('flex'); } catch(error) { setWritingLoading(false); $('writing-task').classList.remove('hidden'); $('writing-task').classList.add('flex'); alert(error instanceof TypeError?'无法连接到批改接口。请先测试模型连接，并确认开发服务器已重启或 Railway 已重新部署。':error instanceof Error?error.message:'批改失败，请稍后重试'); } });
      $('writing-again').addEventListener('click', () => { $('writing-text').value=''; $('writing-result').classList.add('hidden'); $('writing-task').classList.remove('hidden'); $('writing-task').classList.add('flex'); });
      async function openCandidateReview(text, sourceLabel) { const res=await fetch('/api/vocab/library/candidates',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({text,scope:'entries'})}); const data=await res.json(); if(!res.ok){throw new Error(data.error||'提取失败');} if(!data.candidates?.length){throw new Error('这篇笔记中没有识别到可导入的词汇条目');} candidateBatch=data; $('candidate-source').textContent=sourceLabel ? `来源：${sourceLabel}` : ''; $('candidate-list').innerHTML=data.candidates.map((c,i)=>`<label class="studio-checkbox ${c.existing?'':'checked'}"><input type="checkbox" ${c.existing?'':'checked'} data-candidate-index="${i}"><span class="check-mark"></span><span class="flex-1 min-w-0"><span class="studio-badge">${c.existing?'已存在':'新词'}</span><div class="grid md:grid-cols-2 xl:grid-cols-5 gap-2 mt-2"><input id="candidate-word-${i}" class="studio-input text-xs" value="${c.entry.word}" aria-label="${c.entry.word} 单词" ${c.existing?'disabled title="已存在词不能在导入时改名"':''}><input id="candidate-pos-${i}" class="studio-input text-xs" value="${c.entry.partOfSpeech}" aria-label="${c.entry.word} 词性"><input id="candidate-zh-${i}" class="studio-input text-xs" value="${c.entry.meaningZh}" aria-label="${c.entry.word} 中文释义"><input id="candidate-en-${i}" class="studio-input text-xs" value="${c.entry.meaningEn}" aria-label="${c.entry.word} 英文释义"><select id="candidate-level-${i}" class="studio-input text-xs" aria-label="${c.entry.word} 掌握等级" ${c.existing?'disabled title="请在词汇库中调整已有词的等级"':''}><option value="1" ${c.entry.mastery===1?'selected':''}>1 初识</option><option value="2" ${c.entry.mastery===2?'selected':''}>2 认得</option><option value="3" ${c.entry.mastery===3?'selected':''}>3 能用</option><option value="4" ${c.entry.mastery===4?'selected':''}>4 熟练</option><option value="5" ${c.entry.mastery===5?'selected':''}>5 稳定</option></select></div></span></label>`).join(''); $('library-add-menu').classList.add('hidden'); $('library-add-menu').classList.remove('flex'); $('library-add-btn').setAttribute('aria-expanded', 'false'); $('candidate-review').classList.remove('hidden'); $('candidate-review').classList.add('flex'); $('candidate-review').scrollIntoView({behavior:'smooth',block:'start'}); }
      async function openSelectedNoteCandidateReview(trigger) { if(!selectedNote){alert('请先从左侧选择一篇笔记');return;} const previous=trigger.textContent; trigger.disabled=true; trigger.textContent='正在读取笔记...'; try { const noteRes=await fetch('/api/vocab/note-content?slug='+encodeURIComponent(selectedNote.slug)); const noteData=await noteRes.json(); if(!noteRes.ok) throw new Error(noteData.error||'读取笔记失败'); trigger.textContent='正在提取候选词...'; await openCandidateReview(noteData.content||'', selectedNote.title); } catch(error) { alert(error instanceof Error ? error.message : '提取失败，请稍后重试'); } finally { trigger.disabled=false; trigger.textContent=previous; } }
      $('candidate-cancel-btn').addEventListener('click',()=>{$('candidate-review').classList.add('hidden');$('candidate-review').classList.remove('flex');candidateBatch=null;});
      $('candidate-import-btn').addEventListener('click',async()=>{if(!candidateBatch)return; const button=$('candidate-import-btn'); const items=[...$('candidate-list').querySelectorAll('input[type="checkbox"]:checked')].map(input=>{const i=Number(input.dataset.candidateIndex);const c=candidateBatch.candidates[i];return {action:c.existing?'updateMeanings':'create',entry:{...c.entry,word:$(`candidate-word-${i}`).value,partOfSpeech:$(`candidate-pos-${i}`).value,meaningZh:$(`candidate-zh-${i}`).value,meaningEn:$(`candidate-en-${i}`).value,mastery:Number($(`candidate-level-${i}`).value)}};}); if(!items.length){alert('请至少选择一个候选词');return;} button.disabled=true; button.textContent='正在加入...'; try { const res=await fetch('/api/vocab/library/import',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({items,expectedRevision:candidateBatch.revision})}); const data=await res.json(); if(!res.ok) throw new Error(data.error||'导入失败，请刷新词库后重试'); const parts=[]; if(data.created?.length)parts.push(`新增 ${data.created.length} 个`); if(data.updated?.length)parts.push(`更新 ${data.updated.length} 个`); showToast(`词汇库已更新：${parts.join('，')}`,'success'); $('candidate-review').classList.add('hidden'); $('candidate-review').classList.remove('flex'); candidateBatch=null; await loadLibrary(); } catch(error) { alert(error instanceof Error ? error.message : '导入失败，请稍后重试'); } finally { button.disabled=false; button.textContent='确认加入'; } });
      $('library-add-note-btn').addEventListener('click',(event)=>openSelectedNoteCandidateReview(event.currentTarget));
      $('enrich-import-btn').addEventListener('click',(event)=>openSelectedNoteCandidateReview(event.currentTarget));
      $('paste-import-btn').addEventListener('click',async()=>{try{await openCandidateReview($('paste-textarea').value.trim(),'粘贴文本');}catch(error){alert(error instanceof Error ? error.message : '提取失败，请稍后重试');}});
      function openSelectionConfirm() { const words = libraryEntries.slice().sort((a,b)=>a.mastery-b.mastery).slice(0,5); if (words.length < 3) { alert('词汇库至少需要 3 个词'); return false; } $('selection-confirm-list').innerHTML = words.map((e,i)=>`<label class="studio-checkbox checked"><input type="checkbox" checked data-selection-index="${libraryEntries.indexOf(e)}" data-selection-word="${e.word}"><span class="check-mark"></span><span class="flex-1"><strong>${e.word}</strong> <span class="studio-badge">等级 ${e.mastery}</span><div class="grid md:grid-cols-4 gap-2 mt-2"><input id="selection-pos-${libraryEntries.indexOf(e)}" class="studio-input text-xs" value="${e.partOfSpeech}" aria-label="${e.word} 词性"><input id="selection-zh-${libraryEntries.indexOf(e)}" class="studio-input text-xs" value="${e.meaningZh}" aria-label="${e.word} 中文释义"><input id="selection-en-${libraryEntries.indexOf(e)}" class="studio-input text-xs" value="${e.meaningEn}" aria-label="${e.word} 英文释义"><select id="selection-level-${libraryEntries.indexOf(e)}" class="studio-input text-xs" aria-label="${e.word} 掌握等级"><option ${e.mastery===1?'selected':''}>1</option><option ${e.mastery===2?'selected':''}>2</option><option ${e.mastery===3?'selected':''}>3</option><option ${e.mastery===4?'selected':''}>4</option><option ${e.mastery===5?'selected':''}>5</option></select></div></span></label>`).join(''); $('selection-confirm').classList.remove('hidden'); $('selection-confirm').classList.add('flex'); return true; }
      $('selection-cancel-btn').addEventListener('click', () => { $('selection-confirm').classList.add('hidden'); selectionConfirmed=false; });
      $('selection-confirm-btn').addEventListener('click', async () => { const checked=[...$('selection-confirm-list').querySelectorAll('input:checked')]; if(!checked.length){alert('请至少选择一个词汇');return;} confirmedEntries=checked.map(input=>{const i=Number(input.dataset.selectionIndex);return {word:input.dataset.selectionWord,partOfSpeech:$(`selection-pos-${i}`).value,meaningZh:$(`selection-zh-${i}`).value,meaningEn:$(`selection-en-${i}`).value,mastery:Number($(`selection-level-${i}`).value)};}); $('selection-confirm').classList.add('hidden'); $('selection-confirm').classList.remove('flex'); if(pendingSelectionAction === 'writing'){ setWritingLoading(true,'正在生成写作任务','AI 正在结合本次词汇准备题目与段落结构...'); try { const res=await fetch('/api/vocab/writing/task',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({topic:$('writing-topic').value,paragraphType:$('writing-type').value,targetCount:confirmedEntries.length,selectedEntries:confirmedEntries})}); const data=await res.json(); if(!res.ok)throw new Error(data.error||'无法生成任务'); writingTask=data.task; $('writing-instruction').textContent=writingTask.instruction; $('writing-hints').innerHTML=writingTask.structureHints.map(h=>`<li>${escapeHtml(h)}</li>`).join(''); $('writing-words').innerHTML=confirmedEntries.map(w=>`<span class="studio-badge">${escapeHtml(w.word)} · ${escapeHtml(w.meaningZh)}</span>`).join(''); setWritingLoading(false); $('writing-task').classList.remove('hidden'); $('writing-task').classList.add('flex'); } catch(error) { setWritingLoading(false); $('writing-config').classList.remove('hidden'); $('writing-config').classList.add('flex'); alert(error instanceof Error?error.message:'无法生成任务，请稍后重试'); } } else { selectionConfirmed=true; $('exercise-generate-btn').click(); } });

      // ── Checkbox toggles ──
      document.addEventListener('click', (e) => {
        const checkbox = e.target.closest('.studio-checkbox');
        if (!checkbox || e.target.closest('input:not([type="checkbox"]), select, textarea, button')) return;
        checkbox.classList.toggle('checked');
      });

      // ── UI updates ──
      function updateUI() {
        const hasNote = !!selectedNote;
        const isPaste = exerciseSource === 'paste';
        const pasteReady = pasteAnalyzed;

        // source toggle highlight
        $('src-note-btn').classList.toggle('studio-action--primary', !isPaste);
        $('src-paste-btn').classList.toggle('studio-action--primary', isPaste);

        // note-source prompt: only in note source when no note selected
        $('exercise-no-note').classList.toggle('hidden', isPaste || hasNote);

        // paste panel: only in paste source
        $('exercise-paste-panel').classList.toggle('hidden', !isPaste);
        $('exercise-paste-panel').classList.toggle('flex', isPaste);

        // exercise form: note source needs a note; paste source needs entries analyzed
        const showForm = (!isPaste && hasNote) || (isPaste && pasteReady);
        $('exercise-content').classList.toggle('hidden', !showForm);
        if (!showForm) $('exercise-content').classList.remove('flex');

        // Enrich tab (unaffected by exerciseSource)
        $('enrich-no-note').classList.toggle('hidden', hasNote);
        $('enrich-content').classList.toggle('hidden', !hasNote);
        if (!hasNote) $('enrich-content').classList.remove('flex');

        $('library-add-note-btn').disabled = !hasNote;
        $('library-add-note-context').textContent = hasNote
          ? `当前笔记：${selectedNote.title}`
          : '尚未选择左侧笔记，请先选择后再提取';
      }

      function getCheckedTypes() {
        const checked = [];
        $('exercise-types').querySelectorAll('.studio-checkbox.checked').forEach((cb) => {
          checked.push(cb.dataset.type);
        });
        return checked;
      }

      function getCheckedEnrichOptions() {
        const opts = {};
        $('enrich-options').querySelectorAll('.studio-checkbox.checked').forEach((cb) => {
          opts[cb.dataset.option] = true;
        });
        return opts;
      }

      function defaultFilename(mode) {
        if (mode === 'enrich') {
          return selectedNote ? selectedNote.slug : '';
        }
        const base = exerciseSource === 'paste'
          ? (generatedTitle || '粘贴文本词汇')
          : (selectedNote ? selectedNote.slug : '');
        return base ? `${base}-练习册` : '';
      }

      function showPreview(content, mode, title) {
        generatedTitle = title;
        $('preview-content').value = content;
        $('preview-filename').value = defaultFilename(mode);
        $('preview-panel').classList.remove('hidden');
        $('preview-panel').classList.add('flex');
        $('preview-mode-badge').textContent = mode === 'exercise' ? '练习册' : '丰富笔记';
        $('save-btn-label').textContent = '保存';
      }

      function showToast(message, type) {
        const container = $('toast-container');
        const toast = document.createElement('div');
        toast.className = `studio-toast ${type}`;

        const msgSpan = document.createElement('span');
        msgSpan.textContent = message;
        msgSpan.style.flex = '1';

        const closeBtn = document.createElement('button');
        closeBtn.className = 'toast-close';
        closeBtn.innerHTML = '✕';
        closeBtn.onclick = () => toast.remove();

        toast.appendChild(msgSpan);
        toast.appendChild(closeBtn);
        container.appendChild(toast);

        // Errors stay 15s, success 4s
        const duration = type === 'error' ? 15000 : 4000;
        toast._timer = setTimeout(() => toast.remove(), duration);
        // Hover pauses the timer
        toast.addEventListener('mouseenter', () => clearTimeout(toast._timer));
        toast.addEventListener('mouseleave', () => {
          toast._timer = setTimeout(() => toast.remove(), type === 'error' ? 8000 : 2000);
        });
      }

      // ── Exercise source toggle + paste-text analyze ──
      function sanitizeClientSlug(s) {
        return (s || '')
          .replace(/[/\\:*?"<>|]/g, '')
          .replace(/\s+/g, '-')
          .trim();
      }

      function switchExerciseSource(src) {
        if (exerciseSource === src) return;
        exerciseSource = src;
        // Clear stale preview so a prior generation can't be saved under the
        // wrong source/mode.
        generatedTitle = null;
        $('preview-panel').classList.add('hidden');
        $('preview-panel').classList.remove('flex');
        $('preview-content').value = '';
        $('preview-filename').value = '';
        updateUI();
      }

      $('src-note-btn').addEventListener('click', () => switchExerciseSource('note'));
      $('src-paste-btn').addEventListener('click', () => switchExerciseSource('paste'));

      $('paste-analyze-btn').addEventListener('click', async () => {
        const text = $('paste-textarea').value.trim();
        if (!text) {
          showToast('请先粘贴文本', 'error');
          return;
        }
        const btn = $('paste-analyze-btn');
        btn.disabled = true;
        btn.innerHTML = '<span class="studio-spinner"></span> 分析中...';
        try {
          const res = await fetch('/api/vocab/generate', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ mode: 'analyze', text }),
          });
          if (!res.ok) {
            const err = await res.json();
            throw new Error(err.error || '分析失败');
          }
          const data = await res.json();
          pasteWordCount = data.wordCount || 0;
          pasteAnalyzed = !!data.connected;
          $('paste-count').textContent = `共 ${pasteWordCount} 个英文单词`;
          const connEl = $('paste-conn');
          if (data.connected) {
            connEl.textContent = '· ✅ 模型连接正常';
            connEl.style.color = '';
          } else {
            connEl.textContent = `· ⚠️ 模型连接失败：${data.error || '未知错误'}`;
            connEl.style.color = 'var(--accent-spot)';
          }
          $('paste-result').classList.remove('hidden');
          $('paste-result').classList.add('flex');
          // Clear any stale preview from a previous generation.
          generatedTitle = null;
          $('preview-panel').classList.add('hidden');
          $('preview-panel').classList.remove('flex');
          $('preview-content').value = '';
          $('preview-filename').value = '';
          updateUI();
          if (data.connected) {
            showToast(`✅ 模型连接正常，共 ${pasteWordCount} 个英文单词`, 'success');
          } else {
            showToast(`⚠️ 模型连接失败：${data.error || '未知错误'}`, 'error');
          }
        } catch (e) {
          showToast(`❌ ${e.message}`, 'error');
        } finally {
          btn.disabled = false;
          btn.innerHTML = '🔍 分析词汇';
        }
      });

      // ── Generate: Exercise ──
      $('exercise-generate-btn').addEventListener('click', async () => {
        if (!selectionConfirmed) { openSelectionConfirm(); return; }
        selectionConfirmed = false;
        const types = getCheckedTypes();
        if (types.length === 0 && !$('exercise-custom').value.trim()) {
          showToast('请至少选择一种题型或填写自定义题型', 'error');
          return;
        }
        const isPaste = exerciseSource === 'paste';
        if (isPaste && !pasteAnalyzed) {
          showToast('请先点击「分析词汇」并确认模型连接正常', 'error');
          return;
        }

        const btn = $('exercise-generate-btn');
        const statusEl = $('exercise-status');
        btn.disabled = true;
        btn.innerHTML = '<span class="studio-spinner"></span> 生成中...';
        statusEl.classList.remove('hidden');
        statusEl.textContent = '正在调用 AI 生成练习册，可能需要 10-30 秒...';

        try {
          const body = confirmedEntries.length > 0
            ? {
                mode: 'exercise',
                selectedEntries: confirmedEntries,
                types: types.length > 0 ? types : ['en_to_cn'],
                customFormat: $('exercise-custom').value.trim() || undefined,
                title: '词汇库筛选练习',
              }
            : isPaste
            ? {
                mode: 'exercise',
                text: $('paste-textarea').value.trim(),
                types: types.length > 0 ? types : ['en_to_cn'],
                customFormat: $('exercise-custom').value.trim() || undefined,
              }
            : {
                mode: 'exercise',
                slug: selectedNote.slug,
                types: types.length > 0 ? types : ['en_to_cn'],
                customFormat: $('exercise-custom').value.trim() || undefined,
              };

          const res = await fetch('/api/vocab/generate', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(body),
          });

          if (!res.ok) {
            const err = await res.json();
            throw new Error(err.error || '生成失败');
          }

          const data = await res.json();
          const previewTitle = data.title || (isPaste ? '粘贴文本词汇' : selectedNote.title);
          showPreview(data.generated, 'exercise', previewTitle);
          showToast('✅ 练习册生成成功！', 'success');
        } catch (e) {
          showToast(`❌ ${e.message}`, 'error');
        } finally {
          btn.disabled = false;
          btn.innerHTML = '🪄 生成练习册';
          statusEl.classList.add('hidden');
        }
      });

      // ── Generate: Enrich ──
      $('enrich-generate-btn').addEventListener('click', async () => {
        const options = getCheckedEnrichOptions();
        if (Object.keys(options).length === 0) {
          showToast('请至少选择一种丰富内容', 'error');
          return;
        }

        const btn = $('enrich-generate-btn');
        const statusEl = $('enrich-status');
        btn.disabled = true;
        btn.innerHTML = '<span class="studio-spinner"></span> 生成中...';
        statusEl.classList.remove('hidden');
        statusEl.textContent = '正在调用 AI 丰富笔记内容，可能需要 10-30 秒...';

        try {
          const body = {
            mode: 'enrich',
            slug: selectedNote.slug,
            enrichOptions: options,
          };

          const res = await fetch('/api/vocab/generate', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(body),
          });

          if (!res.ok) {
            const err = await res.json();
            throw new Error(err.error || '生成失败');
          }

          const data = await res.json();
          showPreview(data.generated, 'enrich', data.title || selectedNote.title);
          showToast('✅ 笔记内容生成成功！请预览确认后再保存', 'success');
        } catch (e) {
          showToast(`❌ ${e.message}`, 'error');
        } finally {
          btn.disabled = false;
          btn.innerHTML = '🪄 生成丰富内容';
          statusEl.classList.add('hidden');
        }
      });

      // ── Save ──
      $('save-btn').addEventListener('click', async () => {
        const content = $('preview-content').value;
        if (!content || !content.trim()) {
          showToast('没有可保存的内容', 'error');
          return;
        }
        const filename = $('preview-filename').value.trim();
        if (!filename) {
          showToast('文件名不能为空', 'error');
          return;
        }

        const btn = $('save-btn');
        btn.disabled = true;
        btn.innerHTML = '<span class="studio-spinner"></span> 保存中...';

        try {
          const body = {
            mode: currentMode,
            slug: sanitizeClientSlug(filename),
            originalSlug: (currentMode === 'enrich' && selectedNote) ? selectedNote.slug : undefined,
            content,
            title: generatedTitle || filename,
          };

          const res = await fetch('/api/vocab/save', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(body),
          });

          if (!res.ok) {
            const err = await res.json();
            throw new Error(err.error || '保存失败');
          }

          const data = await res.json();
          showToast(`✅ 保存成功！文件: ${data.path}`, 'success');
          // Refresh notes list to include the new/updated file
          loadNotes();
          loadLibrary();
        } catch (e) {
          showToast(`❌ ${e.message}`, 'error');
        } finally {
          btn.disabled = false;
          btn.innerHTML = `💾 <span id="save-btn-label">保存</span>`;
        }
      });

      // ── Copy ──
      $('copy-btn').addEventListener('click', async () => {
        const content = $('preview-content').value;
        if (!content) return;
        try {
          await navigator.clipboard.writeText(content);
          showToast('📋 已复制到剪贴板', 'success');
        } catch (e) {
          showToast('复制失败，请手动选择复制', 'error');
        }
      });

      // ── Clear preview ──
      $('clear-preview-btn').addEventListener('click', () => {
        generatedTitle = null;
        $('preview-content').value = '';
        $('preview-filename').value = '';
        $('preview-panel').classList.add('hidden');
        $('preview-panel').classList.remove('flex');
      });

      // ── Init ──
      async function init() {
        const authed = await checkAuth();
        if (authed) {
          loginOverlay.classList.add('hidden');
          workspace.classList.remove('hidden');
          loadNotes();
        }
        updateUI();
      }

      init();
    })();
    </script>
  </body>
</html>
