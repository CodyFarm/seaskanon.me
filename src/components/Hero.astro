---
import { Icon } from "astro-icon/components";
import { Picture } from "astro:assets";
import img from "/src/assets/hero.webp";
import imgGold from "/src/assets/dunhuang/dunhuang-gold-profile1.png";

// Per-theme hero portrait. All variants are rendered at build time and
// shown/hidden by syncBannerImages in BaseHead, following the PageBanner
// pattern. Non-dunhuang themes keep the original hero.webp.
const THEME_HERO = {
  'default': img,
  'dunhuang-gold': imgGold,
  'dunhuang-warm': img,
  'dunhuang-cool': img,
};
---

<section
  class="py-20 flex md:flex-row flex-col px-4 md:px-0 gap-10 md:gap-0 self-center max-w-5xl mx-auto"
>
  <div class="flex flex-col gap-6 justify-start items-start md:w-1/2">
    <h1 class="text-pblack">Hi, my name is Cody</h1>
    <p class="text-6xl font-bold">A personal website for notes, creativity, and seasons.</p>
    <p>
      I am a mathematics student exploring programming, literature, and the quiet craft of long-term learning.Here are my writings
    </p>
    <a
      rel="noopener noreferrer"
      href="/writing"
      aria-label="Read Writing"
      class="bg-pgreen px-5 py-3 border-1 border-border-main rounded-lg shadow-card hover:shadow-hover transition"
    >
      Read Writing
    </a>
  </div>
  <div class="md:w-1/2 object-contain flex items-center justify-end p-10 group">
    <a
      aria-label="About seasKanon"
      href="/about"
    >
      <div
        class="bg-pblue border-3 border-border-main rounded-2xl h-52 w-60 shadow-card group-hover:shadow-hover flex transition relative"
      >
        <div
          class="absolute top-16 -right-16 text-5xl bg-pyellow p-2 z-10 shadow-card group-hover:shadow-hover transition rounded-full border-3 border-border-main"
        >
          <Icon name="beach" />
        </div>
        <div
          class="absolute text-nowrap flex items-center gap-4 -bottom-12 right-0 pr-4 bg-pgreen pl-1 z-10 shadow-card1 group-hover:shadow-card transition rounded-full border-3 border-border-main"
        >
          <Icon name="beach" />
          <p>seasKanon</p>
        </div>
        <div class="h-80 w-60 relative -mt-30">
          <!-- 默认 / 盛唐 / 北凉：沿用原 overflow-hidden 圆角裁剪效果 -->
          <div class="absolute inset-0 overflow-hidden rounded-2xl">
            {Object.entries(THEME_HERO)
              .filter(([themeKey]) => themeKey !== 'dunhuang-gold')
              .map(([themeKey, themeImg]) => (
                <Picture
                  class="object-bottom absolute bottom-0 group-hover:scale-105 transition"
                  style="display:none"
                  data-banner-theme={themeKey}
                  src={themeImg}
                  format="webp"
                  sizes="(max-width: 300px) 100vw, 600px"
                  widths={[300, 600]}
                  alt="seasKanon visual portrait"
                />
              ))}
          </div>
          <!-- 敦煌鎏彩：整张方图显示，右侧溢出卡片 -->
          <div class="absolute inset-0 overflow-visible">
            <Picture
              class="absolute bottom-4 -left-12 h-full w-auto max-w-none object-cover group-hover:scale-105 transition"
              style="display:none"
              data-banner-theme="dunhuang-gold"
              src={imgGold}
              format="webp"
              sizes="(max-width: 300px) 100vw, 600px"
              widths={[300, 600]}
              alt="seasKanon gold portrait"
            />
          </div>
        </div>
      </div></a
    >
  </div>
</section>
