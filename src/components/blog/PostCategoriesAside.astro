---
import type { TaxonomyCount } from "@/lib/writing";

interface Props {
  categories: TaxonomyCount[];
  activeSlug: string;
}

const { categories, activeSlug } = Astro.props;
---

<section class="rounded-3xl border-[3px] border-border-main bg-category-bg p-5 shadow-card">
  <span
    class="inline-block rounded-lg border-2 border-border-main bg-category-header px-4 py-1.5 text-xl font-bold shadow-card1"
  >
    Categories
  </span>

  {categories.length > 0 ? (
    <ul class="mt-4 flex flex-col gap-2">
      {categories.map((cat) => (
        <li>
          <a
            href={`/writing/categories/${cat.slug}/`}
            class="flex items-center justify-between gap-2 rounded-xl border-2 border-border-main bg-card px-3 py-2 text-sm font-semibold shadow-card1 transition hover:-translate-y-0.5 hover:shadow-card"
          >
            <span class="flex min-w-0 items-center gap-2 text-text-main">
              {cat.slug === activeSlug && (
                <span class="inline-flex h-5 w-5 shrink-0 items-center justify-center rounded-full border border-border-main bg-pgreen" title="Current post category">
                  <svg width="12" height="12" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="m3 8 3 3 7-7" />
                  </svg>
                  <span class="sr-only">Current post category: </span>
                </span>
              )}
              <span>{cat.name}</span>
            </span>
            <span class="shrink-0 rounded-full border border-border-main bg-pblue px-2 py-0.5 text-xs">
              {cat.count}
            </span>
          </a>
        </li>
      ))}
    </ul>
  ) : (
    <p class="mt-4 text-sm text-pblack">No categories yet.</p>
  )}
</section>
