---
import type { TaxonomyCount } from "@/lib/writing";

interface Props {
  tags: TaxonomyCount[];
  activeSlugs: string[];
}

const { tags, activeSlugs } = Astro.props;
const currentTags = tags.filter((tag) => activeSlugs.includes(tag.slug));
---

<section class="rounded-3xl border-[3px] border-border-main bg-tag-bg p-5 shadow-card">
  <span
    class="inline-block rounded-lg border-2 border-border-main bg-ppink px-4 py-1.5 text-xl font-bold shadow-card1"
  >
    Tags
  </span>

  {currentTags.length > 0 ? (
    <div class="mt-4 flex flex-wrap gap-2">
      {currentTags.map((tag) => (
        <a
          href={`/writing/tags/${tag.slug}/`}
          class="inline-flex items-center gap-1.5 rounded-full border-2 border-border-main bg-card px-3 py-1 text-sm font-semibold shadow-card1 transition hover:-translate-y-0.5 hover:shadow-card"
        >
          <span>#{tag.name}</span>
          <span class="text-xs text-pblack">{tag.count}</span>
        </a>
      ))}
    </div>
  ) : (
    <p class="mt-4 text-sm text-pblack">No tags for this post.</p>
  )}
</section>
